{
  "expo": {
    "name": "SlugSwap",
    "slug": "slugswap",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/src/brand/slug-swap-app-icon-1024.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/src/brand/slug-swap-mark-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F1E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.slugswap",
      "buildNumber": "55",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/src/brand/slug-swap-mark-1024.png",
        "backgroundColor": "#F6F1E5"
      },
      "package": "com.anonymous.slugswap"
    },
    "web": {
      "favicon": "./assets/src/brand/slug-swap-app-icon-1024.png"
    },
    "experiments": {
      "baseUrl": "/app",
      "reactCompiler": true
    },
    "scheme": "slugswap",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow SlugSwap to use your location for maps!"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0a8a9f3-0326-4767-b97d-d610d058d094"
      }
    },
    "owner": "darthnithin",
    "updates": {
      "url": "https://u.expo.dev/a0a8a9f3-0326-4767-b97d-d610d058d094",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
