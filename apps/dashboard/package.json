{
  "name": "@slugswap/dashboard",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.7.5",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "^15.5.20",
    "pg": "^8.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.17",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "predev": "npm run build:mobile-web",
    "dev": "next dev",
    "build:mobile-web": "rm -rf public/app && mkdir -p public/app && sh -c 'if [ -f ../../.env ]; then dotenv -e ../../.env -- sh -c \"EXPO_BASE_URL=app npm --prefix ../mobile run web:build -- --output-dir ../dashboard/public/app\"; else EXPO_BASE_URL=app npm --prefix ../mobile run web:build -- --output-dir ../dashboard/public/app; fi'",
    "build": "npm run build:mobile-web && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test lib/server/**/*.test.ts"
  }
}
