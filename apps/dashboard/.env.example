# Neon/Postgres
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=verify-full

# Supabase authentication
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# GET Tools account linking and API access
GET_LOGIN_URL=https://get.cbord.com/ucsc/full/login.php?mobileapp=1
GET_API_BASE_URL=https://services.get.cbord.com/GETServices/services/json
GET_CREDENTIAL_SECRET=<strong-random-secret-for-pin-encryption>
GET_SYSTEM_USERNAME=get_mobile
GET_SYSTEM_PASSWORD=NOTUSED
GET_SYSTEM_DOMAIN=

# Dashboard administration and cache revalidation
ADMIN_EMAIL_ALLOWLIST=<comma-separated-admin-emails>
ADMIN_SESSION_SECRET=<strong-random-session-signing-secret>
REVALIDATE_SECRET=<strong-random-revalidation-secret>

# Comma-, semicolon-, or whitespace-separated production client origins
CORS_ALLOWED_ORIGINS=https://slugswap.vercel.app
